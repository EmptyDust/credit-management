# Backend
BACKEND_HTTP_PORT=8082
GIN_MODE=release
DATABASE_DSN=postgres://postgres:password@localhost:5433/credit_management?sslmode=disable
BUILD_VERSION=dev

# PostgreSQL container
POSTGRES_DB=credit_management
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password

# Redis container
REDIS_ADDR=127.0.0.1:6379
REDIS_PORT=6379
REDIS_PASSWORD=password
REDIS_DB=0

# Storage
STORAGE_BACKEND=local
STORAGE_LOCAL_ROOT=./backend/tmp/storage
STORAGE_PUBLIC_URL=http://localhost:8082/uploads
